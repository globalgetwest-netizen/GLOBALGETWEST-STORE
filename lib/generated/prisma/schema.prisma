// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// 1. Customers
model Customer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  password_hash String?
  first_name    String?
  last_name     String?
  phone         String?
  status        String   @default("active")
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @default(now()) @db.Timestamptz

  addresses CustomerAddress[]
  carts     Cart[]
  orders    Order[]
  wishlists Wishlist[]
  reviews   ProductReview[]

  @@map("customers")
}

// 2. Customer Addresses
model CustomerAddress {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String   @db.Uuid
  type           String
  recipient_name String
  company        String?
  address_line_1 String
  address_line_2 String?
  city           String
  state_province String
  postal_code    String
  country        String
  phone          String
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

// 3. Categories
model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id   String?  @db.Uuid
  name        String
  description String?
  image_key   String?
  slug        String   @unique
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

// 3a. Currencies
model Currency {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String  @unique // ISO code
  symbol    String
  rate      Decimal @default(1.0) @db.Decimal(12, 6)
  is_active Boolean @default(true)

  @@map("currencies")
}

// 3b. Shipping Rules
model ShippingRule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  min_weight Decimal? @db.Decimal(8, 3)
  max_weight Decimal? @db.Decimal(8, 3)
  min_price  Decimal? @db.Decimal(12, 2)
  max_price  Decimal? @db.Decimal(12, 2)
  rate       Decimal  @db.Decimal(12, 2)
  region     String?

  @@map("shipping_rules")
}

// 4. Products
model Product {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                 String?   @unique
  slug                String    @unique
  name                String
  short_description   String?
  full_description    String?
  brand               String?
  category_id         String?   @db.Uuid
  status              String    @default("draft")
  published_state     String    @default("unpublished")
  base_price          Decimal   @default(0) @db.Decimal(12, 2)
  compare_at_price    Decimal?  @db.Decimal(12, 2)
  cost                Decimal?  @db.Decimal(12, 2)
  currency            String    @default("USD")
  weight              Decimal?  @db.Decimal(8, 3)
  length              Decimal?  @db.Decimal(8, 3)
  width               Decimal?  @db.Decimal(8, 3)
  height              Decimal?  @db.Decimal(8, 3)
  stock_quantity      Int       @default(0)
  low_stock_threshold Int?      @default(5)
  tax_category        String?
  seo_title           String?
  seo_description     String?
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @db.Timestamptz
  published_at        DateTime? @db.Timestamptz

  category            Category?                 @relation(fields: [category_id], references: [id], onDelete: SetNull)
  images              ProductImage[]
  variants            ProductVariant[]
  cart_items          CartItem[]
  order_items         OrderItem[]
  reviews             ProductReview[]
  wishlist_items      WishlistItem[]
  inventory_movements InventoryMovement[]
  health_info         ProductHealthInfo[]
  ingredients         ProductIngredient[]
  dietary_attributes  ProductDietaryAttribute[]
  health_claims       HealthClaim[]
  warnings            ProductWarning[]
  evidence            EvidenceReference[]
  product_attributes  ProductAttribute[]

  @@map("products")
}

// 5. Product Images
model ProductImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  alt_text   String?
  sort_order Int      @default(0)
  image_key  String
  created_at DateTime @default(now()) @db.Timestamptz

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// 6. Product Variants
model ProductVariant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id       String   @db.Uuid
  sku              String?  @unique
  name             String
  attributes       Json?
  price_adjustment Decimal  @default(0) @db.Decimal(12, 2)
  stock_quantity   Int      @default(0)
  weight           Decimal? @db.Decimal(8, 3)
  length           Decimal? @db.Decimal(8, 3)
  width            Decimal? @db.Decimal(8, 3)
  height           Decimal? @db.Decimal(8, 3)
  barcode          String?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  product             Product             @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart_items          CartItem[]
  order_items         OrderItem[]
  wishlist_items      WishlistItem[]
  inventory_movements InventoryMovement[]

  @@map("product_variants")
}

// 7. Inventory Movements
model InventoryMovement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String?  @db.Uuid
  variant_id  String?  @db.Uuid
  change_type String
  quantity    Int
  reference   String?
  notes       String?
  created_at  DateTime @default(now()) @db.Timestamptz

  product Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@map("inventory_movements")
}

// 8. Carts
model Cart {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  customer Customer?  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

// 9. Cart Items
model CartItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id    String   @db.Uuid
  product_id String   @db.Uuid
  variant_id String?  @db.Uuid
  quantity   Int
  unit_price Decimal  @db.Decimal(12, 2)
  currency   String
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  cart    Cart            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@map("cart_items")
}

// 10. Orders
model Order {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number       String?  @unique
  customer_id        String?  @db.Uuid
  currency           String
  subtotal           Decimal  @default(0) @db.Decimal(12, 2)
  discount_amount    Decimal  @default(0) @db.Decimal(12, 2)
  tax_amount         Decimal  @default(0) @db.Decimal(12, 2)
  shipping_amount    Decimal  @default(0) @db.Decimal(12, 2)
  grand_total        Decimal  @default(0) @db.Decimal(12, 2)
  payment_status     String   @default("pending")
  fulfillment_status String   @default("pending")
  shipping_address   Json?
  billing_address    Json?
  shipping_method    String?
  tracking_number    String?
  notes              String?
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @default(now()) @db.Timestamptz

  customer                 Customer?             @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  items                    OrderItem[]
  payments                 Payment[]
  shipments                Shipment[]
  shipping_address_details OrderShippingAddress?

  @@map("orders")
}

// 10a. Order Shipping Address (Snapshot)
model OrderShippingAddress {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String  @unique @db.Uuid
  full_name             String
  email                 String
  phone                 String
  country               String
  state_province        String
  city                  String
  address_line_1        String
  address_line_2        String?
  postal_code           String
  delivery_instructions String?

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_shipping_addresses")
}

// 11. Order Items
model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String   @db.Uuid
  product_id      String   @db.Uuid
  variant_id      String?  @db.Uuid
  product_name    String
  product_sku     String?
  variant_name    String?
  quantity        Int
  unit_price      Decimal  @db.Decimal(12, 2)
  currency        String
  discount_amount Decimal  @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal  @default(0) @db.Decimal(12, 2)
  total_price     Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now()) @db.Timestamptz

  order   Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// 12. Payments
model Payment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String   @db.Uuid
  provider         String
  provider_tx_id   String?
  amount           Decimal  @db.Decimal(12, 2)
  currency         String
  status           String   @default("pending")
  payment_method   String?
  gateway_response Json?
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

// 13. Shipments
model Shipment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String    @db.Uuid
  carrier            String?
  service            String?
  tracking_number    String?
  status             String    @default("pending")
  shipping_cost      Decimal   @db.Decimal(12, 2)
  currency           String
  estimated_delivery DateTime? @db.Timestamptz
  actual_delivery    DateTime? @db.Timestamptz
  notes              String?
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @db.Timestamptz

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("shipments")
}

// 14. Coupons / Discounts
model Coupon {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String    @unique
  description              String?
  discount_type            String
  discount_value           Decimal   @db.Decimal(12, 2)
  currency                 String?
  minimum_purchase         Decimal   @default(0) @db.Decimal(12, 2)
  maximum_discount         Decimal?  @db.Decimal(12, 2)
  starts_at                DateTime? @db.Timestamptz
  ends_at                  DateTime? @db.Timestamptz
  usage_limit              Int?
  usage_limit_per_customer Int?      @default(1)
  current_usage            Int       @default(0)
  applies_to               String?
  applies_to_ids           Json?
  active                   Boolean   @default(true)
  created_at               DateTime  @default(now()) @db.Timestamptz
  updated_at               DateTime  @default(now()) @db.Timestamptz

  @@map("coupons")
}

// 15. Product Reviews
model ProductReview {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String   @db.Uuid
  customer_id String?  @db.Uuid
  rating      Int
  title       String?
  comment     String?
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  product  Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@map("product_reviews")
}

// 16. Wishlists
model Wishlist {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id String   @db.Uuid
  name        String   @default("My Wishlist")
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  customer Customer       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@map("wishlists")
}

// 17. Wishlist Items
model WishlistItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlist_id String   @db.Uuid
  product_id  String   @db.Uuid
  variant_id  String?  @db.Uuid
  added_at    DateTime @default(now()) @db.Timestamptz

  wishlist Wishlist        @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@map("wishlist_items")
}

// 18. Admin Users
model AdminUser {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  password_hash String
  first_name    String?
  last_name     String?
  role          String    @default("admin")
  is_active     Boolean   @default(true)
  last_login    DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @db.Timestamptz

  @@map("admin_users")
}

// 19. Audit Logs
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_type  String
  actor_id    String?  @db.Uuid
  actor_email String?
  action      String
  entity_type String
  entity_id   String?  @db.Uuid
  entity_name String?
  changes     Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  @@map("audit_logs")
}

// 20. Settings
model Setting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json?
  description String?
  updated_at  DateTime @default(now()) @db.Timestamptz

  @@map("settings")
}

// --- Health Information Architecture ---

// A. Medical/health conditions
model HealthCondition {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  slug        String              @unique
  description String?
  status      String              @default("active")
  products    ProductHealthInfo[]

  @@map("health_conditions")
}

model ProductHealthInfo {
  product_id   String          @db.Uuid
  condition_id String          @db.Uuid
  relationship String?
  product      Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  condition    HealthCondition @relation(fields: [condition_id], references: [id], onDelete: Cascade)

  @@id([product_id, condition_id])
  @@map("product_health_info")
}

// D. Ingredients
model Ingredient {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  description String?
  status      String              @default("active")
  products    ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  product_id    String     @db.Uuid
  ingredient_id String     @db.Uuid
  details       String?
  product       Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@id([product_id, ingredient_id])
  @@map("product_ingredients")
}

// C. Dietary attributes
model DietaryAttribute {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                    @unique
  slug        String                    @unique
  description String?
  products    ProductDietaryAttribute[]

  @@map("dietary_attributes")
}

model ProductDietaryAttribute {
  product_id   String           @db.Uuid
  attribute_id String           @db.Uuid
  product      Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attribute    DietaryAttribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@id([product_id, attribute_id])
  @@map("product_dietary_attributes")
}

// E. Health claims
model HealthClaim {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String  @db.Uuid
  claim_text      String
  claim_type      String // e.g., "Supports", "Intended use"
  status          String  @default("draft")
  supporting_info String?
  product         Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("health_claims")
}

// F. Warnings
model ProductWarning {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String  @db.Uuid
  warning_text String
  product      Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_warnings")
}

// G. Evidence/References
model EvidenceReference {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String  @db.Uuid
  title       String
  source      String
  url         String?
  publication String?
  notes       String?
  product     Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("evidence_references")
}

// --- Phase 2 Foundation: Structured Attributes & Tax Rules ---

// H. Attribute catalog (e.g., Size, Color, Material)
model Attribute {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @unique
  slug             String   @unique
  type             String   @default("text") // text | select | number | boolean
  description      String?
  is_variant_level Boolean  @default(false)
  sort_order       Int      @default(0)
  status           String   @default("active")
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  product_attributes ProductAttribute[]

  @@map("attributes")
}

model ProductAttribute {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String    @db.Uuid
  attribute_id String    @db.Uuid
  value        String
  product      Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attribute    Attribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@unique([product_id, attribute_id])
  @@map("product_attributes")
}

// I. Tax rules foundation
model TaxRule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  country      String?
  region       String?
  postal_code  String?
  rate         Decimal  @db.Decimal(6, 4)
  tax_category String?
  priority     Int      @default(0)
  is_compound  Boolean  @default(false)
  active       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @db.Timestamptz

  @@map("tax_rules")
}
